{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ]
}
